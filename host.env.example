# Host settings: copy to host.env (git-ignored). scripts/main.sh and scripts/aux.sh source it; or `source host.env` before python -m src.run.
export BIPA_ASSETS=/data/bipa/assets            # artifacts/ (recorded runs) and cache/ (episode cache); default ./assets
export HARNESS_BENCH_ROOT=/data/harness-bench   # the harness-bench checkout; default ../harness-bench
export BIPA_OUT=/data/bipa/out                  # analysis outputs; default ./out
# export BIPA_ANALYSIS_CACHE=/data/bipa/analysis   # the analyses' intermediate files; default $BIPA_ASSETS/cache/analysis
# export BIPA_EXPERIMENTS=/data/bipa/old-pins.yaml  # another experiments file (its pins: the run of each cell); default configs/experiments.yaml
# Roots that older records mention (separated by ':'); their artifacts/ and cache/ map to BIPA_ASSETS. Default none.
# export BIPA_LEGACY_ROOTS=/old/project:/old/bench
# export BIPA_SEED_FILE=/data/bipa/seed/SKILL.md   # default skills/seed/SKILL.md
# Optimizer endpoint, https only, when OPENAI_BASE_URL_2 in harness-bench's .env is not (keys are read from there too).
# export OPENAI_BASE_URL_2_OPTIMIZER=https://gateway.example/v1

# Model calls through the host's proxy, if it has one; the cluster's own addresses go direct.
# export http_proxy=http://proxy.example:3128 https_proxy=http://proxy.example:3128
# export no_proxy=localhost,127.0.0.1 NO_PROXY=localhost,127.0.0.1
# unset all_proxy ALL_PROXY
# The image cache (rclone) has a fallback: when it is unreachable each call should fail in seconds, not retry for minutes.
export RCLONE_CONTIMEOUT=10s RCLONE_TIMEOUT=60s RCLONE_RETRIES=1 RCLONE_LOW_LEVEL_RETRIES=2
